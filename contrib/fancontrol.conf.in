# fancontrol configuration template for the UGREEN DXP2800 GT.
#
# scripts/ugreen-init.sh renders this file at boot, replacing
#   @HWMON@    with the hwmon directory name of the ugreen_cs201x device
#              (hwmon0, hwmon3, ... - the number is not stable across boots,
#               which is why this is a template and not a static config)
#   @DEVPATH@  with the device path fancontrol validates against
#   @DISKTEMP@ with the path of contrib/max-drivetemp, which prints the
#              hottest drive temperature (drivetemp module) for pwm2
#
# Everything else is meant to be edited by hand. All pwm values are 0-255;
# the EC only has 1 % resolution, so ~2.5 pwm steps per percent.
#
# pwm1/fan1/temp1 = CPU fan and CPU NTC
# pwm2/fan2        = system fan, driven by the hottest drive instead of
#                    the board NTC (temp2_input is still readable)
# If your machine only populates one of the two fan headers, delete the
# entries for the missing one from every line below.

INTERVAL=10

DEVPATH=@HWMON@=@DEVPATH@
DEVNAME=@HWMON@=ugreen_cs201x

FCTEMPS=@HWMON@/pwm1=@HWMON@/temp1_input @HWMON@/pwm2=!@DISKTEMP@
FCFANS=@HWMON@/pwm1=@HWMON@/fan1_input @HWMON@/pwm2=@HWMON@/fan2_input

# Below MINTEMP the fan runs at MINPWM, above MAXTEMP at MAXPWM,
# and it interpolates linearly in between.
MINTEMP=@HWMON@/pwm1=50 @HWMON@/pwm2=0
MAXTEMP=@HWMON@/pwm1=75 @HWMON@/pwm2=100

# MINSTART: pwm needed to spin a stopped fan back up.
# MINSTOP:  lowest pwm at which the fan keeps turning.
# Both must be measured on the actual machine - see README.md. Measured here:
# fan1 never stops down to pwm 20 (1067 rpm); fan2 stops at pwm 20 and is at
# 197 rpm at 30. MINSTOP keeps a margin above those, and fancontrol requires
# MINSTOP >= MINPWM. pwm1 follows the CPU NTC, which idled at about 46 C, so
# its MINTEMP sits a few degrees above.
#
# pwm2 follows the drives (42-45 C measured), but its "temperature" is a
# virtual one: contrib/max-drivetemp maps the real drive temperature through
# a piecewise curve and prints the value that makes the straight line below
# (MINTEMP=0, MAXTEMP=100, MINSTOP=MINPWM=40, MAXPWM=255) land on the
# intended pwm. So do not tune pwm2 here - edit CURVE in max-drivetemp, and
# keep its LOW_PWM/HIGH_PWM equal to pwm2's MINSTOP/MAXPWM below. Run
# "contrib/max-drivetemp --debug" to see the real temperature and the pwm.
MINSTART=@HWMON@/pwm1=40 @HWMON@/pwm2=60
MINSTOP=@HWMON@/pwm1=30 @HWMON@/pwm2=40

# MINPWM > 0 keeps the fans turning at all times. A NAS with spinning disks
# should never let them stop completely.
MINPWM=@HWMON@/pwm1=30 @HWMON@/pwm2=40
MAXPWM=@HWMON@/pwm1=255 @HWMON@/pwm2=255
